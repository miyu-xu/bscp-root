package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["external_rutabaga_gfx_license"],
}

rust_bindgen {
    name: "libmesa3d_magma_drm_bindgen_rutabaga",
    crate_name: "mesa3d_magma_drm_bindgen",
    wrapper_src: "headers/drm.h",
    source_stem: "drm_bindings",
    bindgen_flags: [
        "--with-derive-default",
        "--allowlist-var",
        "DRM_.+",
        "--allowlist-var",
        "drm_.+",
        "--allowlist-type",
        "drm_.+",
        "--no-prepend-enum-name",
        "--no-doc-comments",
        "--no-layout-tests",
    ],
    host_supported: true,
    vendor_available: true,
    apex_available: ["com.android.virt"],
}

rust_bindgen {
    name: "libmesa3d_magma_amdgpu_bindgen_rutabaga",
    crate_name: "mesa3d_magma_amdgpu_bindgen",
    wrapper_src: "headers/amdgpu_drm.h",
    source_stem: "amdgpu_bindings",
    bindgen_flags: [
        "--with-derive-default",
        "--allowlist-var",
        "DRM_AMDGPU_.+",
        "--allowlist-var",
        "AMDGPU_.+",
        "--allowlist-type",
        "drm_amdgpu_.+",
        "--no-prepend-enum-name",
        "--no-doc-comments",
        "--no-layout-tests",
    ],
    host_supported: true,
    vendor_available: true,
    apex_available: ["com.android.virt"],
}

