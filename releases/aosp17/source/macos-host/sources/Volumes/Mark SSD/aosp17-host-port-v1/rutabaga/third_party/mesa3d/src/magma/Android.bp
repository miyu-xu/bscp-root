rust_bindgen {
    name: "libmesa3d_magma_virtgpu_bindgen_rutabaga",
    crate_name: "mesa3d_magma_virtgpu_bindgen",
    wrapper_src: "headers/virtgpu_drm.h",
    source_stem: "virtgpu_bindings",
    bindgen_flags: [
        "--with-derive-default",
        "--allowlist-var",
        "DRM_VIRTPU.+",
        "--allowlist-var",
        "VIRTGPU_.+",
        "--allowlist-type",
        "drm_virtgpu_.+",
        "--no-prepend-enum-name",
        "--no-doc-comments",
        "--no-layout-tests",
    ],
    host_supported: true,
    vendor_available: true,
    apex_available: ["com.android.virt"],
}

rust_bindgen {
    name: "libmesa3d_magma_i915_bindgen_rutabaga",
    crate_name: "mesa3d_magma_i915_bindgen",
    wrapper_src: "headers/i915_drm.h",
    source_stem: "i915_bindings",
    bindgen_flags: [
        "--with-derive-default",
        "--allowlist-var",
        "DRM_I915.+",
        "--allowlist-var",
        "I915_.+",
        "--allowlist-type",
        "drm_i915_.+",
        "--no-prepend-enum-name",
        "--no-doc-comments",
