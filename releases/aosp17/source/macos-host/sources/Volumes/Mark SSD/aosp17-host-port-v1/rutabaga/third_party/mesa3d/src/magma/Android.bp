rust_bindgen {
    name: "libmesa3d_magma_xe_bindgen_rutabaga",
    crate_name: "mesa3d_magma_xe_bindgen",
    wrapper_src: "headers/xe_drm.h",
    source_stem: "xe_bindings",
    bindgen_flags: [
        "--with-derive-default",
        "--allowlist-var",
        "DRM_XE.+",
        "--allowlist-var",
        "XE_.+",
        "--allowlist-type",
        "drm_xe_.+",
        "--no-prepend-enum-name",
        "--no-doc-comments",
        "--no-layout-tests",
    ],
    host_supported: true,
    vendor_available: true,
    apex_available: ["com.android.virt"],
}

rust_library {
    name: "libmesa3d_magma_android_rutabaga",
    host_supported: true,
    vendor_available: true,
    crate_name: "mesa3d_magma",
    cargo_env_compat: true,
    cargo_pkg_version: "0.1.62",
    crate_root: "lib.rs",
    edition: "2021",
    cfgs: ["avoid_cargo"],
    rustlibs: [
        "libcfg_if",
        "liblog_rust",
        "libmesa3d_util_rutabaga",
        "libmesa3d_protocols_rutabaga",
        "libvirtgpu_kumquat_rutabaga",
        "libthiserror",
        "libzerocopy",
        "librustix",
        "liblibc",
        // Bindgen libraries
        "libmesa3d_magma_amdgpu_bindgen_rutabaga",
        "libmesa3d_magma_drm_bindgen_rutabaga",
        "libmesa3d_magma_i915_bindgen_rutabaga",
        "libmesa3d_magma_msm_bindgen_rutabaga",
        "libmesa3d_magma_virtgpu_bindgen_rutabaga",
        "libmesa3d_magma_xe_bindgen_rutabaga",
    ],
    proc_macros: ["libremain"],
    apex_available: ["com.android.virt"],
}
