@@ -59,6 +59,14 @@ Namespace BuildSphalNamespace([[maybe_unused]] const Context& ctx) {
 
   AddLlndkLibraries(ctx, &ns, VndkUserPartition::Vendor);
 
+  // This core HAL is installed in the BSCP graphics Microdroid system image.
+  // Keep all namespace paths and other library links unchanged. Never enable
+  // this for ordinary images, recovery, APEX, or non-system sections.
