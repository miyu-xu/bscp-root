diff --git a/contents/tests/configuration/sphal_test.cc b/contents/tests/configuration/sphal_test.cc
index 51ac2a6..ce6a790 100644
--- a/contents/tests/configuration/sphal_test.cc
+++ b/contents/tests/configuration/sphal_test.cc
@@ -37,3 +37,35 @@ TEST(sphal, rs_should_come_before_vndk) {
   });
   EXPECT_LT(rs, vndk) << "rs should come before vndk";
 }
+
+TEST(sphal, microdroid_graphics_link_is_exact_and_system_only) {
+  for (auto section : {SectionType::System, SectionType::Vendor, SectionType::Product,
+                       SectionType::Unrestricted, SectionType::Other}) {
+    for (auto type : {LinkerConfigType::Default, LinkerConfigType::Legacy,
+                      LinkerConfigType::Recovery, LinkerConfigType::ApexBinary}) {
+      Context baseline;
+      baseline.SetCurrentSection(section);
+      baseline.SetCurrentLinkerConfigType(type);
+      auto before = BuildSphalNamespace(baseline);
+      baseline.SetMicrodroidGraphics(true);
+      auto after = BuildSphalNamespace(baseline);
+      const bool enabled = section == SectionType::System && type == LinkerConfigType::Default;
+      size_t found = 0;
+      for (const auto& link : after.Links()) {
+        for (const auto& lib : link.GetSharedLibs()) {
+          if (lib == "vulkan.ranchu.so") {
+            ++found;
+            EXPECT_EQ("default", link.To());
+            EXPECT_FALSE(link.IsAllSharedLibsAllowed());
+          }
+        }
+      }
+      EXPECT_EQ(enabled ? 1u : 0u, found);
+      if (enabled) before.GetLink("default").AddSharedLib("vulkan.ranchu.so");
+      ConfigWriter old_writer, new_writer;
+      before.WriteConfig(old_writer);
+      after.WriteConfig(new_writer);
+      EXPECT_EQ(old_writer.ToString(), new_writer.ToString());
+    }
+  }
+}
