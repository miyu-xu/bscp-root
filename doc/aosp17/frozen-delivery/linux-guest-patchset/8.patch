+
+// Expose the HAL loader name without changing namespace search paths.
+// Preserve the official HAL installation and provide its loader name in this
+// image only. The image also explicitly depends on the actual core HAL above.
+install_symlink {
+    name: "microdroid_vulkan_ranchu_link",
+    installed_location: "lib64/vulkan.ranchu.so",
+    symlink_target: "hw/vulkan.ranchu.so",
+}
+
+// Signed, image-local opt-in consumed by the formal linkerconfig generator.
+// The file is absent from nongraphics images; it grants only the named HAL link.
+prebuilt_etc {
+    name: "microdroid_graphics_linkerconfig",
+    filename: "microdroid-graphics-linkerconfig",
+    src: "microdroid-graphics-linkerconfig",
+}
