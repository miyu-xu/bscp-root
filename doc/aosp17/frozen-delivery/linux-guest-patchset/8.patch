diff --git a/build/apex/product_packages.mk b/build/apex/product_packages.mk
index ea447c7ab..a30dba838 100644
--- a/build/apex/product_packages.mk
+++ b/build/apex/product_packages.mk
@@ -62,3 +62,21 @@ ifdef RELEASE_AVF_ENABLE_NETWORK
     $(error RELEASE_AVF_ENABLE_LLPVM_CHANGES must also be enabled)
   endif
 endif
+
+# Desktop Microdroid graphics are an explicit build option. Do not alter the
+# default normal Guest or its debug/ADB policy when this option is absent.
+ifneq ($(strip $(BSCP_MICRODROID_GRAPHICS)),)
+  ifneq ($(words $(BSCP_MICRODROID_GRAPHICS)),1)
+    $(error BSCP_MICRODROID_GRAPHICS must be true or false)
+  endif
+  ifeq ($(filter true false,$(BSCP_MICRODROID_GRAPHICS)),)
+    $(error BSCP_MICRODROID_GRAPHICS must be true or false)
+  endif
+  $(call soong_config_set,bscp,microdroid_graphics,$(BSCP_MICRODROID_GRAPHICS))
+endif
+
+# Use the official GKI and normal initrd for loadable virtio GPU modules.
+# Keep the standard Microdroid kernel and policy unchanged without this opt-in.
+ifeq ($(strip $(BSCP_MICRODROID_GRAPHICS)),true)
+  PRODUCT_AVF_MICRODROID_GUEST_GKI_VERSION := android15_66
+endif
