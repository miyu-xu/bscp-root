 bool ResourceTracker::supportsAsyncQueueSubmit() const {
+#if defined(BSCP_REQUIRE_NATIVE_SUBMIT_RESULT) && BSCP_REQUIRE_NATIVE_SUBMIT_RESULT
+    // Strict submit-result profile: the virtio capability bootstrap assumes
+    // async support without consulting render-control feature negotiation.
+    // The existing reply-bearing opcode preserves native acceptance errors;
+    // the old void async wire cannot carry those per-submission results.
+    return false;
+#else
     // Opt-in diagnostic/compatibility fallback: use the existing reply-bearing
     // vkQueueSubmit/2 protocol. No opcode is added and no result is fabricated.
     const char* exact = std::getenv("BSCP_REQUIRE_SUBMIT_RESULTS");
     if (exact && std::strcmp(exact, "1") == 0) return false;
     return mFeatureInfo.hasVulkanAsyncQueueSubmit;
+#endif
 }
 
