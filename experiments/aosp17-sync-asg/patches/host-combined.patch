+VkResult DeviceOpTracker::SubmissionStatus() {
+    std::lock_guard<std::mutex> lock(mFailedFenceMutex);
+    return mDeviceLost ? VK_ERROR_DEVICE_LOST : VK_SUCCESS;
+}
+bool DeviceOpTracker::ReserveFailureOwnership() {
+    std::lock_guard<std::mutex> lock(mFailedFenceMutex);
+    if (mDeviceLost || mFailureReservations == kFailureOwnershipLimit) return false;
+    ++mFailureReservations;
+    return true;
+}
+void DeviceOpTracker::ReleaseFailureOwnership() {
+    std::lock_guard<std::mutex> lock(mFailedFenceMutex);
+    if (!mFailureReservations) GFXSTREAM_FATAL("Failure ownership reservation underflow");
+    --mFailureReservations;
+}
+void DeviceOpTracker::RecordSubmissionError(VkResult error) {
+    if (error == VK_ERROR_DEVICE_LOST) {
+        std::lock_guard<std::mutex> lock(mFailedFenceMutex);
+        mDeviceLost = true;
+    }
+}
+
+VkResult DeviceOpTracker::AcquireInternalFence(VkFence* out) {
+    *out = VK_NULL_HANDLE;
+    if (mReuseCompletedFences) {
+        std::lock_guard<std::mutex> lock(mCompletedFenceMutex);
+        if (!mCompletedFences.empty()) {
+            *out=mCompletedFences.back(); mCompletedFences.pop_back();
+        }
+    }
+    if (*out != VK_NULL_HANDLE) {
+        VkResult result=mDeviceDispatch->vkResetFences(mDevice,1,out);
+        if (result!=VK_SUCCESS) {
+            mDeviceDispatch->vkDestroyFence(mDevice,*out,nullptr); *out=VK_NULL_HANDLE;
+        }
+        return result;
+    }
+    const VkFenceCreateInfo info={VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,nullptr,0};
+    return mDeviceDispatch->vkCreateFence(mDevice,&info,nullptr,out);
+}
+void DeviceOpTracker::RetireInternalFence(VkFence fence, bool succeeded) {
+    if (mReuseCompletedFences && succeeded) {
+        std::lock_guard<std::mutex> lock(mCompletedFenceMutex);
+        if (mCompletedFences.size()<64) { mCompletedFences.push_back(fence); return; }
+    }
+    mDeviceDispatch->vkDestroyFence(mDevice,fence,nullptr);
+}
 
