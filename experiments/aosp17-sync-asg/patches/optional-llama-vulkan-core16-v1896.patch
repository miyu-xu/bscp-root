+        } else if (device->physical_device.getProperties().apiVersion < VK_API_VERSION_1_1) {
+            throw std::runtime_error("16-bit storage requires Vulkan 1.1 or VK_KHR_16bit_storage");
+        }
+        fprintf(stderr, "BSCP_VK_CORE16 feature=%u extension=%u\n",
